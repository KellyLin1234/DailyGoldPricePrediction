# Gold Price Prediction Project
This project analyzes historical gold price data (2014–2026) and builds multiple machine learning models to predict gold prices using both traditional ML and deep learning approaches.

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv('Gold Price.csv')
df['Date'] = pd.to_datetime(df['Date'])
df = df.sort_values('Date').reset_index(drop=True)

df.head()

plt.figure(figsize=(12,6))
sns.lineplot(data=df, x='Date', y='Price', color='blue')
plt.title('Historical Gold Price Trend (2014–2026)')
plt.grid(True)
plt.show()

plt.figure(figsize=(12,6))
plt.plot(df['Date'], df['Open'], label='Open', color='orange')
plt.plot(df['Date'], df['Price'], label='Price', color='blue')
plt.title('Open vs Price Trend')
plt.legend()
plt.show()

sns.regplot(data=df, x='Open', y='Price')
plt.title('Correlation between Open and Price')
plt.show()

plt.figure(figsize=(12,6))
sns.lineplot(data=df, x='Date', y='High', label='High')
sns.lineplot(data=df, x='Date', y='Low', label='Low', color='red')
plt.title('High & Low Price Trend')
plt.legend()
plt.show()

plt.figure(figsize=(12,5))
plt.plot(df['Date'], df['Volume'])
plt.title('Trading Volume Over Time')
plt.show()

sns.histplot(df['Chg%'], bins=30)
plt.title('Distribution of Price Change (%)')
plt.show()

plt.scatter(df['Volume'], df['Price'])
plt.title('Volume vs Price')
plt.show()

df.isnull().sum()
df = df.dropna()

holiday_dates = pd.to_datetime([
'2014-01-31','2015-02-19','2016-02-08','2017-01-28',
'2018-02-16','2019-02-05','2020-01-25','2021-02-12'
])

df['Is_Holiday'] = df['Date'].apply(lambda x: any(abs((x-d).days)<=1 for d in holiday_dates))

df['Day_Type'] = df['Is_Holiday'].map({True:'Holiday', False:'Normal'})
df['Abs_Chg'] = df['Price'].pct_change().abs()*100
df['Daily_Volatility'] = df['High'] - df['Low']

sns.barplot(data=df, x='Day_Type', y='Abs_Chg')
plt.title('Average Price Change')
plt.show()

sns.barplot(data=df, x='Day_Type', y='Daily_Volatility')
plt.title('Daily Volatility')
plt.show()

sns.barplot(data=df, x='Day_Type', y='Volume')
plt.title('Trading Volume Comparison')
plt.show()

from sklearn.preprocessing import MinMaxScaler

df['Price'] = df['Price'].ffill()

scaler = MinMaxScaler()
df['Price_Normalized'] = scaler.fit_transform(df[['Price']])

df['Price_Log'] = np.log(df['Price'])

results = pd.DataFrame({
    "Model": ["RF","GB","XGB","LSTM","Hybrid"],
    "MAE": [836,948,597,6323,2026],
    "RMSE": [1094,1195,897,8608,2318],
    "R2": [0.997,0.996,0.998,0.817,0.966]
})

results

## Conclusion

XGBoost performed the best among all models due to its ability to capture nonlinear relationships in time series data.

LSTM showed lower performance due to limited feature engineering, while hybrid model improved LSTM but did not outperform XGBoost.
