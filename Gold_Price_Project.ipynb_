   "source": [
    "plt.figure(figsize=(12,6))\n",
    "plt.plot(df['Date'], df['Open'], label='Open', color='orange')\n",
    "plt.plot(df['Date'], df['Price'], label='Price', color='blue')\n",
    "plt.title('Open vs Price Trend')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
