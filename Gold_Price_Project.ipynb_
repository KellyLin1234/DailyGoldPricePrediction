   ],
   "source": [
    "sns.barplot(data=df, x='Day_Type', y='Volume')\n",
    "plt.title('Trading Volume Comparison')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "6f48999b-beea-483c-8236-589a78fe56a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "df['Price'] = df['Price'].ffill()\n",
    "\n",
    "scaler = MinMaxScaler()\n",
    "df['Price_Normalized'] = scaler.fit_transform(df[['Price']])\n",
    "\n",
    "df['Price_Log'] = np.log(df['Price'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "6807eb77-10c7-4b5f-8424-36961d794372",
