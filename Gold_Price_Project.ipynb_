       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "sns.barplot(data=df, x='Day_Type', y='Abs_Chg')\n",
    "plt.title('Average Price Change')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "70840577-a781-4332-80f2-d67f1c3f3c04",
   "metadata": {},
