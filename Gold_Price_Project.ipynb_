   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "b9c586f1-4e99-40cb-8c16-3bc874e9e329",
   "metadata": {},
   "outputs": [],
   "source": [
    "df.isnull().sum()\n",
    "df = df.dropna()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "2f127bd7-4286-4fc2-8349-37b9de601027",
   "metadata": {},
   "outputs": [],
   "source": [
    "holiday_dates = pd.to_datetime([\n",
    "'2014-01-31','2015-02-19','2016-02-08','2017-01-28',\n",
    "'2018-02-16','2019-02-05','2020-01-25','2021-02-12'\n",
    "])\n",
    "\n",
    "df['Is_Holiday'] = df['Date'].apply(lambda x: any(abs((x-d).days)<=1 for d in holiday_dates))\n",
    "\n",
    "df['Day_Type'] = df['Is_Holiday'].map({True:'Holiday', False:'Normal'})\n",
    "df['Abs_Chg'] = df['Price'].pct_change().abs()*100\n",
    "df['Daily_Volatility'] = df['High'] - df['Low']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "46c76873-5bb4-4623-b9c3-cf5275ce4718",
   "metadata": {},
